{
  "name": "amigo-invisible",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-amigo-invisible",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-amigo-invisible \"vitest run tests/rules\"",
    "check:domains": "bash scripts/check-domains.sh",
    "test:smoke": "firebase emulators:exec --only auth,firestore --project demo-amigo-invisible \"bash tests/smoke/session.sh\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-amigo-invisible \"vitest run tests/integration\"",
    "test:e2e": "node tests/e2e/flujo-sorteo.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^0.400.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "playwright-core": "1.56",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
