# Copy this file to .env and fill in real values for local dev.
# In AWS Amplify, set these as environment variables in the console.

# --- Database ---
# Local: point at Docker Postgres (see README)
# Prod: RDS or Aurora Serverless v2 connection string
DATABASE_URL="postgresql://amigo:amigo@localhost:5432/amigo_invisible?schema=public"

# --- Auth.js core ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# In prod set this to your public URL, e.g. https://amigoinvisible.com
AUTH_URL="http://localhost:3000"
# Controls auth-trust-host in Auth.js v5 (needed on Amplify/behind proxy)
AUTH_TRUST_HOST="true"

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (magic link + invitation emails) ---
# Local dev: use Mailpit/Mailhog or any SMTP you want to stub
# Prod: Amazon SES SMTP credentials
EMAIL_SERVER_HOST="email-smtp.us-east-1.amazonaws.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@example.com"
