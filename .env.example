# Copiá este archivo a .env.local para desarrollar contra los emuladores de Firebase.
# No hace falta un proyecto real: "demo-*" es un proyecto ficticio que solo existe en los emuladores.
# En producción (App Hosting) no se usa este archivo: la config llega sola.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_EMULATORS=true

# Config web de Firebase (en dev, valores ficticios para el proyecto demo)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-amigo-invisible.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-amigo-invisible
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Para que el Admin SDK (servidor) hable con los emuladores
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Mails (Resend). Vacío en desarrollo: los mails se muestran en la consola en vez de enviarse.
RESEND_API_KEY=
EMAIL_FROM="Amigo Invisible <no-responder@avisos.amigoinvisible.com.ar>"
